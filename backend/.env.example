# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://lvrtbhamdcqlifyztyoz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Gemini AI Configuration (for LLM features)
# API keys from Google AI Studio may start with AIza (legacy) or AQ. (new auth keys)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq AI Configuration (optional, for faster text-based AI tasks)
# Get your key from: https://console.groq.com/keys
# When configured, Groq handles transcript analysis, response suggestions, and intelligence tasks
# Falls back to Gemini if Groq fails or is not configured
GROQ_API_KEY=

# AI Provider Configuration
# AI_PROVIDER: 'auto' (default) - automatically route tasks to best provider
#              'gemini' - use Gemini for all tasks
#              'groq' - use Groq for text tasks, Gemini for multimodal
# AI_FALLBACK_ENABLED: 'true' (default) - automatically fall back to alternate provider on failure
#                      'false' - do not fall back, return error immediately
AI_PROVIDER=auto
AI_FALLBACK_ENABLED=true

# AssemblyAI Configuration
# Get your API key from: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=